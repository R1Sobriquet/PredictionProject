# ===== Configuration du Pipeline de Prévision ATM =====

# Source de données : "csv" (fichier Excel .xlsx) ou "database"
DATA_SOURCE=csv

# ===== Mode CSV (fichier Excel) =====
# Chemin vers le fichier Excel exporté depuis HFSQL
CSV_FILE_PATH=data/raw/d_CommandesDetailCalcul.xlsx

# ===== Mode Database =====
# Type de base de données : "mysql" ou "sqlserver"
DB_TYPE=mysql

# Paramètres de connexion
DB_SERVER=localhost
DB_NAME=prediction_db
DB_USER=root
DB_PASSWORD=
DB_TABLE=d_CommandesDetailCalcul

# Pour SQL Server uniquement
DB_DRIVER=ODBC Driver 17 for SQL Server

# Options
DB_TIMEOUT=30
DB_DEBUG=False
